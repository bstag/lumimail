# EditorConfig — consistent formatting across editors and agents
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
# Tabs, matching the source: 430 of 462 TypeScript files use them. The config
# previously asked for spaces, so almost every file was in violation of it and
# editors were reformatting against the grain of the codebase.
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab
