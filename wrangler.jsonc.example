{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lumimail",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lumimail",
		},
	],
	// `vars` are stored in plain text and echoed by `wrangler deploy`, so no
	// credential belongs here. Set these as secrets instead:
	//   wrangler secret put CF_TOKEN          // Cloudflare API token
	//   wrangler secret put RESEND_API_KEY    // only when MAIL_PROVIDER=resend
	"vars": {
		"CF_ACCOUNT_ID": "cf-account-id",
		// Name of the Worker that Email Routing rules target. Must match "name"
		// above, or provisioned routing rules will point at a Worker that does
		// not exist.
		"CF_EMAIL_WORKER_NAME": "lumimail",
		// Outbound provider: "cloudflare" (default, verified recipients only) or
		// "resend" (arbitrary recipients). For "resend", set RESEND_API_KEY via
		// `wrangler secret put RESEND_API_KEY` and keep the send_email binding below.
		"MAIL_PROVIDER": "cloudflare",
		// Canonical HTTPS origin and a sender on an Email Sending-enabled domain.
		"PUBLIC_APP_URL": "https://mail.example.com",
		"PASSWORD_RESET_FROM": "noreply@example.com",
		// Set to "true" to let the hourly sweep delete R2 objects that are both
		// unreferenced in D1 and older than the retention age (F63). Leave unset
		// on a new deployment until `GET /api/admin/r2-retention` has been read,
		// so an existing backlog is never removed before anyone has seen it.
		// "R2_SWEEP_ENABLED": "true",
	},
	"observability": {
		"enabled": true,
	},
	"triggers": {
		"crons": [
			"* * * * *",
		],
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lumimail",
			"database_id": "your-d1-db-id",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "lumimail-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "lumimail-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "lumimail-outbound",
			},
			{
				// Metrics-only use by the queue-health checker.
				"binding": "OUTBOUND_DLQ_QUEUE",
				"queue": "lumimail-outbound-dlq",
			},
		],
		"consumers": [
			{
				"queue": "lumimail-inbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "lumimail-outbound",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "lumimail-outbound-dlq",
			},
			{
				"queue": "lumimail-outbound-dlq",
				"max_batch_size": 5,
				"max_retries": 3,
			},
		],
	},
	// Staging (F67). Deploy with: wrangler deploy --env staging
	//
	// Every binding is redeclared because Wrangler replaces binding arrays per
	// environment rather than merging them - an omitted array would inherit the
	// production resource, which is exactly the accident this environment exists to
	// prevent. Production stays the unflagged default.
	//
	// CF_ACCOUNT_ID and the staging zone token are supplied separately; the token
	// MUST be scoped to the staging zone only, or this environment can rewrite
	// production Email Routing.
	"env": {
		"staging": {
			"name": "lumimail-staging",
			"vars": {
				"CF_ACCOUNT_ID": "caddde404ba5d0324c315dc5cf143696",
				"CF_EMAIL_WORKER_NAME": "lumimail-staging",
				"MAIL_PROVIDER": "cloudflare",
				// Replace with the deployed workers.dev origin after first deploy.
				"PUBLIC_APP_URL": "https://lumimail-staging.workers.dev",
				"PASSWORD_RESET_FROM": "noreply@STAGING_DOMAIN"
				// R2_SWEEP_ENABLED deliberately unset, as in production: never enable
				// a destructive sweep before its report has been read.
			},
			"observability": { "enabled": true },
			"triggers": { "crons": ["* * * * *"] },
			"send_email": [{ "name": "EMAIL", "remote": true }],
			"services": [
				{ "binding": "WORKER_SELF_REFERENCE", "service": "lumimail-staging" }
			],
			"assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
			"images": { "binding": "IMAGES" },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "lumimail-staging",
					"database_id": "STAGING_D1_ID",
					"migrations_dir": "drizzle/migrations"
				}
			],
			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lumimail-raw-staging" }],
			"queues": {
				"producers": [
					{ "binding": "INBOUND_QUEUE", "queue": "lumimail-inbound-staging" },
					{ "binding": "OUTBOUND_QUEUE", "queue": "lumimail-outbound-staging" },
					{ "binding": "OUTBOUND_DLQ_QUEUE", "queue": "lumimail-outbound-dlq-staging" }
				],
				"consumers": [
					{ "queue": "lumimail-inbound-staging", "max_batch_size": 5, "max_retries": 3 },
					{
						"queue": "lumimail-outbound-staging",
						"max_batch_size": 5,
						"max_retries": 3,
						"dead_letter_queue": "lumimail-outbound-dlq-staging"
					},
					{ "queue": "lumimail-outbound-dlq-staging", "max_batch_size": 5, "max_retries": 3 }
				]
			}
		}
	}
}
