{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lumimail-recovery-20260812",
	"main": "./worker.ts",
	"account_id": "caddde404ba5d0324c315dc5cf143696",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"routes": [],
	"assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
	"images": { "binding": "IMAGES" },
	"vars": {
		"CF_ACCOUNT_ID": "caddde404ba5d0324c315dc5cf143696",
		"CF_EMAIL_WORKER_NAME": "lumimail-recovery-20260812",
		"MAIL_PROVIDER": "cloudflare",
		"PUBLIC_APP_URL": "https://lumimail-recovery-20260812.blackstag.workers.dev",
		"PASSWORD_RESET_FROM": "noreply@invalid.example",
		"R2_SWEEP_ENABLED": "false",
		"SEED_ENABLED": "false"
	},
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lumimail-staging",
			"database_id": "d239de97-37f1-4b9a-a664-f787ea60aa97",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lumimail-raw-staging" }]
}
